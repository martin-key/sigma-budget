// The site on Cloudflare Workers (docs/adr/0002-react-router-ssr.md): React Router draws every screen in the Worker (apps/web/workers/app.ts) from
// the current release; the files of site/ (css, js, data, images) are the static assets of the client build.
//   pnpm build                                       # development artifact: build/client (the static files) and build/server (the Worker)
//   pnpm exec wrangler dev                           # after the build: the Worker on http://localhost:8787 (wrangler reads the built config)
//   pnpm build:release --env staging --noindex && pnpm exec wrangler deploy -c apps/web/build/server/wrangler.json     # staging; production is deployed by a version tag through the production environment
// The Vite plugin (@cloudflare/vite-plugin) sets the assets directory to the client build and picks the environment from CLOUDFLARE_ENV.
// html_handling "auto-trailing-slash", not_found_handling "none": a path without a file goes to the Worker (every screen, the release API,
// unknown paths). run_worker_first sends every response through the shared header layer.
// All data files come from the release packaged with the site.
// SITE_ORIGIN names the public address in canonical links (empty: the address of the request); NOINDEX "1" keeps an environment out of
// search engines; SIGMA_URL is the address of the original СИГМА (docs/approach-specification.md, section 2.2); FEEDBACK_EMAIL is the
// address of the feedback form (empty: the form keeps the message in the browser and says so); OPENAI_APPS_CHALLENGE is the token of OpenAI's
// domain check for the plugin directory, served at /.well-known/openai-apps-challenge (docs/openai-plugin.md; empty: 404).

{
  "name": "sigma-budget",
  "routes": [{ "pattern": "sigma-budget.midt.bg", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "main": "./workers/app.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "RELEASE_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 120, "period": 60 }
    },
    // POST /mcp: the ceiling per address, above the share of one session on RELEASE_RATE_LIMITER (docs/release.md)
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "2004",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  // no invocation logs: they would keep the request headers, the visitor's address among them, for up to 7 days (/poveritelnost, client/legal.js);
  // what the Worker logs itself (console) has no personal data
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "vars": {
    "ENVIRONMENT": "production",
    "SITE_ORIGIN": "https://sigma-budget.midt.bg",
    "SIGMA_URL": "https://sigma.midt.bg/",
    "FEEDBACK_EMAIL": "contact@midt.government.bg",
    "NOINDEX": "",
    "OPENAI_APPS_CHALLENGE": ""
  },
  // staging (push to main, .github/workflows/site.yml): its own Worker, a build with --noindex.
  // The top level is production: CI deploys it only from a version tag through the production environment (docs/production-procedure.md).
  "env": {
    "staging": {
      "name": "sigma-budget-staging",
      "ratelimits": [
        {
          "name": "RELEASE_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "MCP_RATE_LIMITER",
          "namespace_id": "2005",
          "simple": { "limit": 600, "period": 60 }
        }
      ],
      // Public staging on sigma-budget-staging.cf-midt.workers.dev, without a custom domain or preview URL.
      // Override inherited production routes: staging serves only its workers.dev address.
      "routes": [],
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "staging",
        "SITE_ORIGIN": "https://sigma-budget-staging.cf-midt.workers.dev",
        "SIGMA_URL": "https://sigma.midt.bg/",
        "FEEDBACK_EMAIL": "",
        "NOINDEX": "1",
        "OPENAI_APPS_CHALLENGE": ""
      }
    }
  }
}
