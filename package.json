{
  "name": "sigma-budget",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "echo \"Development artifact only. Deploy with pnpm build:release (Node + the pinned Playwright Chromium; see README).\" && turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tests/e2e/tsconfig.json",
    "dev": "turbo run dev",
    "test": "turbo run test --concurrency=1",
    "format:check": "prettier --check . --ignore-unknown",
    "build:release": "node apps/web/scripts/build-release.ts",
    "check:coverage": "node scripts/check-coverage.mjs",
    "format": "prettier --write . --ignore-unknown",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "data:pull": "node scripts/data-pull.ts",
    "data:check": "node scripts/check-release-lock.ts"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@react-router/dev": "7.18.4",
    "@types/node": "24.10.1",
    "axe-core": "4.10.3",
    "prettier": "3.8.3",
    "turbo": "2.9.14",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.156.0",
    "@vitest/coverage-v8": "4.1.12"
  }
}
