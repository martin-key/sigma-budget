#!/bin/sh
# Production Node CLI. Historical Python packages use ./budget-python explicitly.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if ! command -v node >/dev/null 2>&1 || ! node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 24 ? 0 : 1)' 2>/dev/null; then
  echo "budget: needs Node 24+" >&2
  exit 2
fi
if ! command -v pnpm >/dev/null 2>&1; then
  echo "budget: needs pnpm 10.33.0; install the locked workspace dependencies first" >&2
  exit 2
fi
cd "$root"
# Turbo rebuilds changed source and reuses cached workspace build outputs;
# the launcher never installs dependencies or falls back to a Python producer.
if ! pnpm exec turbo run build --filter=@sigma-budget/etl... >&2; then
  echo "budget: build failed; run pnpm install --frozen-lockfile and resolve the build error" >&2
  exit 2
fi
exec node "$root/apps/etl/dist/cli.js" "$@"
